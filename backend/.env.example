# Required for real synthesis (503 without it unless DEMO_MODE=true)
ANTHROPIC_API_KEY=
# Optional but strongly recommended — highest-volume keyed source (100 requests/day)
NEWSAPI_KEY=

# Optional sources (free tiers). Each source is skipped when its key is empty.
GUARDIAN_API_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=

# Comma-separated browser origins allowed by CORS ("*" for local dev)
ALLOWED_ORIGINS=*
# true = allow keyword-matched fallback briefings without an Anthropic key
DEMO_MODE=false
# Per-IP budget for POST /briefing; 0 disables
RATE_LIMIT_PER_MINUTE=6

GDELT_MIN_INTERVAL_SECONDS=5.5
MAX_ARTICLES_PER_SOURCE=15
DEDUP_SIMILARITY_THRESHOLD=0.85
RELEVANCE_SIMILARITY_THRESHOLD=0.30
HOURS_LOOKBACK=24
SYNTHESIS_MODEL=claude-haiku-4-5
CONTEXT_MODEL=claude-haiku-4-5
OUTLOOK_MODEL=claude-haiku-4-5
# Key figures on development cards: one extra Haiku call per briefing (about half a cent).
FIGURES_MODEL=claude-haiku-4-5
KEY_FIGURES_ENABLED=true
CACHE_TTL_MINUTES=15
# Spend guard: cap on new (uncached) briefings across ALL visitors. 0 = unlimited.
BRIEFING_BUDGET_PER_HOUR=20
BRIEFING_BUDGET_PER_DAY=100
# Cloudflare Turnstile bot check on POST /briefing (secret key from the Cloudflare dashboard).
# Set VITE_TURNSTILE_SITE_KEY on Vercel FIRST, then this on Render. Unset = no check.
TURNSTILE_SECRET_KEY=
# FastAPI's /docs and /openapi.json. Leave unset (off) in production; set true locally if you want them.
# EXPOSE_DOCS=true
# Home's "On the wire" topics: refreshed at most this often (needs ANTHROPIC_API_KEY).
TRENDING_MODEL=claude-haiku-4-5
TRENDING_TTL_MINUTES=60
CONTEXT_ENRICHMENT_LIMIT=4
# Wikimedia Commons file photos for developments and alerts without an outlet image.
COMMONS_IMAGES_ENABLED=true
